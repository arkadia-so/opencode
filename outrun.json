  "commands": [
    {
      "name": "checks:effect-rules",
      "run": "bun run test:effect-simplification-rules && bun run lint:effect-simplifications",
      "inputs": [
        "script/ast-grep/**",
        "packages/**/*.ts",
        "packages/**/*.tsx"
      ]
    },
    {
      "name": "checks:codemode-pack",
      "run": "bun run pack (packages/codemode)",
      "inputs": [
        "packages/codemode/**"
      ],
      "roots": [
        "packages/codemode/**/*.ts",
        "packages/codemode/**/*.tsx"
      ]
    },
    {
      "name": "checks:sdk-package",
      "run": "bun turbo verify:package --filter=@opencode/sdk",
      "inputs": [
        "packages/sdk/**",
        "packages/*/package.json",
        "packages/*/tsconfig*.json"
      ],
      "roots": [
        "packages/sdk/**/*.ts",
        "packages/sdk/**/*.tsx"
      ]
    },
    {
      "name": "checks:client-generated",
      "run": "bun run check:generated (packages/client)",
      "inputs": [
        "packages/client/**"
      ],
      "roots": [
        "packages/client/**/*.ts",
        "packages/client/**/*.tsx"
      ]
    },
    {
      "name": "checks:protocol-generated",
      "run": "bun run check:generated (packages/protocol)",
      "inputs": [
        "packages/protocol/**"
      ],
      "roots": [
        "packages/protocol/**/*.ts",
        "packages/protocol/**/*.tsx"
      ]
    },
    {
      "name": "build",
      "run": "cli build --single + service-smoke; turbo build cli^... app^...; node build + smoke",
      "inputs": [
        "packages/*/package.json",
        "packages/*/tsconfig*.json",
        "packages/*/script/**",
        "packages/cli/**",
        "packages/app/**",
        "packages/ui/**"
      ],
      "roots": [
        "packages/cli/**/*.ts",
        "packages/cli/**/*.tsx",
        "packages/app/**/*.ts",
        "packages/app/**/*.tsx"
      ]
    },
    {
      "name": "e2e:app-1",
      "run": "bun --cwd packages/app test:e2e:built --shard=1/2",
      "inputs": [
        "packages/app/**",
        "packages/ui/**",
        "packages/session-ui/**"
      ],
      "roots": [
        "packages/app/**/*.ts",
        "packages/app/**/*.tsx"
      ]
    },
    {
      "name": "e2e:app-2",
      "run": "bun --cwd packages/app test:e2e:built --shard=2/2",
      "inputs": [
        "packages/app/**",
        "packages/ui/**",
        "packages/session-ui/**"
      ],
      "roots": [
        "packages/app/**/*.ts",
        "packages/app/**/*.tsx"
      ]
    },
    {
      "name": "e2e:session-ui-components",
      "run": "bun --cwd packages/session-ui test:components",
      "inputs": [
        "packages/session-ui/**",
        "packages/stories/**",
        "packages/ui/**"
      ],
      "roots": [
        "packages/session-ui/**/*.ts",
        "packages/session-ui/**/*.tsx",
        "packages/stories/**/*.ts",
        "packages/stories/**/*.tsx"
      ]
    },
    {
      "name": "e2e:app-components",
      "run": "bun --cwd packages/app test:components",
      "inputs": [
        "packages/app/**",
        "packages/stories/**",
        "packages/ui/**"
      ],
      "roots": [
        "packages/app/**/*.ts",
        "packages/app/**/*.tsx",
        "packages/stories/**/*.ts",
        "packages/stories/**/*.tsx"
      ]
    },
    {
      "name": "typecheck",
      "run": "bun run lint && bun run typecheck:tsc",
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/.oxlintrc*",
        "**/oxlint*"
      ]
    }
  ]
}
